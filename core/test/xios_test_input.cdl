 time_counter_bounds =
  99340365, 99340365,
  99345765, 99345765,
  99351165, 99351165,
  99356565, 99356565 ;

 field_1D =
  0, 1, 0, 1 ;

 hice =
  0, 1, 0, 1,
  2, 3, 2, 3,
  0, 1, 0, 1,
  2, 3, 2, 3,
  0, 1, 0, 1,
  2, 3, 2, 3,
  0, 1, 0, 1,
  2, 3, 2, 3 ;
}
